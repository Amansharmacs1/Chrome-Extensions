{
  "manifest_version": 3,
  "name": "QRQuick — QR Code Generator & Scanner",
  "version": "1.0.0",
  "description": "All-in-one QR code generator and scanner. Create, customize, scan, download, and manage QR codes with complete privacy and zero external tracking.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "QRQuick — Generator & Scanner",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "commands": {
    "quick-qr": {
      "suggested_key": {
        "default": "Alt+Shift+Q",
        "mac": "Alt+Shift+Q"
      },
      "description": "Generate QR code for the current webpage"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/icon.svg",
        "assets/icons/icon128.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
