{
  "manifest_version": 3,
  "name": "MeetMorph",
  "version": "1.0.0",
  "description": "Seamlessly vanish and reappear on Google Meet and WebRTC video calls by switching outgoing webcam video to an empty room background.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MeetMorph",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://ome.tv/*",
    "https://*.ome.tv/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://ome.tv/*",
        "https://*.ome.tv/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "video-engine.js",
        "snap-detector.js",
        "page-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*",
        "https://ome.tv/*",
        "https://*.ome.tv/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "test-room.html",
        "test-room.css",
        "test-room.js",
        "icons/*"
      ],
      "matches": [
        "https://meet.google.com/*",
        "https://ome.tv/*",
        "https://*.ome.tv/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ],
  "commands": {
    "toggle-vanish": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "Toggle Vanish / Return Mode"
    }
  }
}
