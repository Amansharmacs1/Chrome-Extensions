{
  "manifest_version": 3,
  "name": "FontLens — Inspect, Identify & Compare Typography",
  "version": "1.0.0",
  "description": "Inspect text elements, identify rendered fonts, analyze typography properties, experiment with live changes, compare fonts, and export clean CSS.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "FontLens — Typography Inspector",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "contextMenus"
  ],
  "commands": {
    "toggle-inspection": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Toggle FontLens Webpage Typography Inspection"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "inspector/inspector.css",
        "scanner/scanner.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
