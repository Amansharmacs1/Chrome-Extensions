{
  "manifest_version": 3,
  "name": "FocusFlow - Pomodoro & Focus Manager",
  "version": "1.0.0",
  "description": "Focus. Flow. Finish. A premium Pomodoro timer, task manager, distraction blocker, and productivity analytics dashboard.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FocusFlow",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "declarativeNetRequest"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ]
}
